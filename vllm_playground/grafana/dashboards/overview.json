    {
      "type": "barchart",
      "title": "Throughput: offered vs completed (requests/s)",
      "description": "If completed < offered, requests pile up in vLLM's queue: the server is past saturation.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "workload-sim"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "workload-sim"
          },
          "queryType": "table",
          "queryText": "SELECT printf('%g req/s', rate) AS rate, offered_rps_med AS offered, steady_requests_per_s_med AS completed FROM sweep_agg WHERE experiment = '$experiment' AND scenario = '$scenario' ORDER BY rate",
